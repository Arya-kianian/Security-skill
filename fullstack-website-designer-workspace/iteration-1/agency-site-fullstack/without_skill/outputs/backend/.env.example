# Apex Studio — Backend Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Server
PORT=4000
NODE_ENV=development

# CORS — the URL of your Next.js frontend
ALLOWED_ORIGIN=http://localhost:3000

# SMTP (leave blank to use Ethereal test account in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password_here

# Who receives contact form notifications
NOTIFY_EMAIL=hello@apexstudio.co
