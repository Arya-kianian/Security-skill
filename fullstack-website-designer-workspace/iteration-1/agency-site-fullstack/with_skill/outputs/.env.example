# =============================================================
# Apex Studio — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# ---- Contact Form (Next.js API route) ----
# Email address that receives contact form submissions
CONTACT_TO_EMAIL=hello@apexstudio.com

# SMTP credentials for sending emails via Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# ---- Separate Express Server (optional bonus backend) ----
# Port the Express server listens on
EXPRESS_PORT=4000

# Allowed CORS origin (your Next.js dev URL)
CORS_ORIGIN=http://localhost:3000

# Secret for any future JWT tokens
JWT_SECRET=change-this-to-a-long-random-string

# ---- Runtime ----
NODE_ENV=development
